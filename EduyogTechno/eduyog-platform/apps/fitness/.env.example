# Copy to apps/fitness/.env (or .env.local) to configure. Vite exposes VITE_*
# values to the browser, so never put secrets in this file.

# Full http(s) URL of the main Eduyog website (websites/eduyog), used by the
# "Back to Eduyog" link. Use the address where you serve that site locally or
# its deployed URL. Leave empty to hide the link.
VITE_EDUYOG_URL=
