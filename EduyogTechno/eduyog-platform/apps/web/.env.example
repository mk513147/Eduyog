# Copy to apps/web/.env (or .env.local) to configure. Vite exposes VITE_* values to the
# browser, so never put secrets in this file. Restart `npm run dev` after changing it.

# Backend API base URL, including the /api prefix, no trailing slash. Used by Eduyarp (login,
# courses, learning, trainer area, account), the Admin console and the Fitness enquiry form
# (POST /api/fitness-leads). There is no default, not even in development: when it is empty or
# not an http(s) URL no API request is made. Eduyarp and Admin then show "The API address is not
# configured." and the Fitness form tells visitors to e-mail instead of sending.
#
# Local development (backend on port 5000; its FRONTEND_URL must include
# http://localhost:5176 so the browser may read the responses):
#   VITE_API_BASE_URL=http://localhost:5000/api
# Production: set this to the deployed API (value not decided yet) before `npm run build`.
VITE_API_BASE_URL=

# Optional override for the "Become a Partner" buttons. Leave empty to use the unified /fitness page
# (the normal setting). Either an app path starting with "/" or a full http(s) URL.
VITE_FITNESS_URL=

# Optional. Public base path if the site is not served from the domain root, for
# example /eduyog/ (must start and end with "/"). Read at build time by vite.config.js.
VITE_BASE_PATH=
