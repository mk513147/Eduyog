# Copy this file to backend/.env and fill in real values locally.
# Never commit .env.

# Server
NODE_ENV=development
PORT=5000

# Allowed frontend origins for CORS, comma-separated, no trailing slash.
# Required when NODE_ENV=production.
FRONTEND_URL=http://localhost:5173

# JWT access tokens. Required. Must be a random secret of at least
# 32 characters; the placeholder below is rejected at startup. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
# Token lifetime: number followed by s, m, h or d. Defaults to 1h.
JWT_EXPIRES_IN=1h

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduyog
DB_USER=your_db_user
DB_PASSWORD=your_db_password
